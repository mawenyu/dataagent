{
  "name": "agui-vue-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-fork.mjs",
    "dev": "vite --port 3001",
    "prebuild": "node scripts/build-fork.mjs",
    "build": "vite build",
    "preview": "vite preview --port 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "budget": "vite build --manifest && node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@a2ui/web_core": "^0.10.4",
    "@ag-ui/client": "0.0.57",
    "@copilotkit/vue": "file:../packages/copilotkit-vue",
    "vue": "3.5.41",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "5.6.2",
    "vite": "5.4.10",
    "vitest": "^3.2.4"
  }
}
