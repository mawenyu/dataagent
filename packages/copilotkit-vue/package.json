{
  "name": "@copilotkit/vue",
  "version": "1.67.1-fork.1",
  "private": true,
  "description": "Internal minimal fork of @copilotkit/vue 1.67.1 (MIT). Only change vs upstream tag v1.67.1: CopilotKitProvider gains a `directAgents` prop, merged as { ...agents__unsafe_dev_only, ...selfManagedAgents, ...directAgents }. See FORK.md.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "v2": [
        "./dist/v2/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v2": {
      "import": {
        "types": "./dist/v2/index.d.mts",
        "default": "./dist/v2/index.mjs"
      },
      "require": {
        "types": "./dist/v2/index.d.cts",
        "default": "./dist/v2/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:css && npm run build:types",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css -m && node scripts/scope-preflight.mjs ./dist/styles.css",
    "build:types": "vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist --skipLibCheck && node -e \"const fs=require('fs');fs.cpSync('./dist/index.d.ts','./dist/index.d.mts');fs.cpSync('./dist/index.d.ts','./dist/index.d.cts');fs.cpSync('./dist/v2/index.d.ts','./dist/v2/index.d.mts');fs.cpSync('./dist/v2/index.d.ts','./dist/v2/index.d.cts')\"",
    "test": "vitest run",
    "check-types": "vue-tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@copilotkit/core": "1.67.1",
    "@copilotkit/shared": "1.67.1",
    "@copilotkit/web-components": "1.67.1",
    "@copilotkit/web-inspector": "1.67.1",
    "@jetbrains/websandbox": "1.3.1",
    "katex": "0.16.47",
    "lucide-vue-next": "0.525.0",
    "streamdown-vue": "1.0.29",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.11",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "0.5.16",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "22.15.3",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/test-utils": "2.4.6",
    "arktype": "^2.2.3",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "1.3.5",
    "typescript": "5.8.2",
    "valibot": "^1.4.2",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "vue": "3.5.41",
    "vue-tsc": "2.2.12"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
